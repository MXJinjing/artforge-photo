{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:module_description",
    "mainElement": "EntryAbility",
    "deviceTypes": ["tablet", "2in1"],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    // ---------------------------------------------------------------------------
    // DEBUG ONLY — 上架前本地模拟「隐私托管」系统弹窗（debug 包 + 真机）。
    // 正式发布：在 AGC 配置隐私托管后，以下 metadata 可删除或将 hosted 改为 "0"；
    // 生产以云端托管声明为准，勿长期保留占位 URL。
    // 官方字段：appgallery_privacy_hosted=1 启用；privacy_statement 须为 https。
    // ---------------------------------------------------------------------------
    "metadata": [
      {
        "name": "appgallery_privacy_hosted",
        "value": "1"
      },
      {
        "name": "appgallery_privacy_link_privacy_statement",
        "value": "https://privacy.example.com/artforge-photo-placeholder"
      }
    ],
    "requestPermissions": [
      { "name": "ohos.permission.FILE_ACCESS_PERSIST" },
      {
        "name": "ohos.permission.PRINT"
      },
      { "name": "ohos.permission.INTERNET" },
      {
        "name": "ohos.permission.READ_PASTEBOARD",
        "reason": "$string:permission_read_pasteboard_reason",
        "usedScene": {
          "abilities": ["EntryAbility"],
          "when": "inuse"
        }
      }
    ],
    "abilities": [
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "description": "$string:module_description",
        "icon": "$media:app_icon",
        "label": "$string:app_name",
        "startWindowIcon": "$media:app_icon",
        "startWindowBackground": "$color:start_window_background",
        "exported": true,
        "launchType": "singleton",
        "supportWindowMode": ["fullscreen", "split", "floating"],
        "skills": [
          {
            "entities": ["entity.system.home"],
            "actions": ["ohos.want.action.home"]
          },
          {
            "actions": ["ohos.want.action.viewData"],
            "uris": [
              {"scheme": "file", "type": "general.jpeg", "linkFeature": "FileOpen"},
              {"scheme": "file", "type": "general.png", "linkFeature": "FileOpen"},
              {"scheme": "file", "type": "general.tiff", "linkFeature": "FileOpen"},
              {"scheme": "file", "type": "general.gif", "linkFeature": "FileOpen"},
              {"scheme": "file", "type": "general.raw-image", "linkFeature": "FileOpen"},
              {"scheme": "file", "type": "general.pbm-image", "linkFeature": "FileOpen"},
              {"scheme": "file", "type": "general.pgm-image", "linkFeature": "FileOpen"},
              {"scheme": "file", "type": "general.ppm-image", "linkFeature": "FileOpen"},
              {"scheme": "file", "type": "com.microsoft.bmp", "linkFeature": "FileOpen"},
              {"scheme": "file", "type": "com.microsoft.ico", "linkFeature": "FileOpen"},
              {"scheme": "file", "type": "com.truevision.tga-image", "linkFeature": "FileOpen"},
              {"scheme": "file", "type": "com.ilm.openexr-image", "linkFeature": "FileOpen"},
              {"scheme": "file", "type": "com.adobe.photoshop-image", "linkFeature": "FileOpen"},
              {"scheme": "file", "type": "io.github.mxjinjing.artforge.photo.pcraft", "linkFeature": "FileOpen"},
              {"scheme": "file", "type": "io.github.mxjinjing.artforge.photo.webp", "linkFeature": "FileOpen"},
              {"scheme": "file", "type": "io.github.mxjinjing.artforge.photo.heif", "linkFeature": "FileOpen"},
              {"scheme": "file", "type": "io.github.mxjinjing.artforge.photo.psb", "linkFeature": "FileOpen"},
              {"scheme": "file", "type": "io.github.mxjinjing.artforge.photo.qoi", "linkFeature": "FileOpen"},
              {"scheme": "file", "type": "io.github.mxjinjing.artforge.photo.hdr", "linkFeature": "FileOpen"},
              {"scheme": "file", "type": "io.github.mxjinjing.artforge.photo.portable-image", "linkFeature": "FileOpen"},
              {"scheme": "file", "type": "io.github.mxjinjing.artforge.photo.camera-raw", "linkFeature": "FileOpen"}
            ]
          }
        ]
      }
    ]
  }
}
